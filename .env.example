DATABASE_URL=postgresql+psycopg://vault:change_me@localhost:5432/vault
# AI_MODE: mock (no AI needed) | ollama (local models) | real (company API, not implemented yet)
AI_MODE=mock
MAX_UPLOAD_MB=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
# Background processing: inline | background | celery (celery needs Redis and a worker, see README)
TASK_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
AUTO_INSIGHTS=false
