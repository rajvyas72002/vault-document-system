DATABASE_URL=postgresql+psycopg://vault:change_me@localhost:5432/vault
# AI_MODE: mock (keyword search, no AI) | real (embeddings + LLM, chosen by CHAT_PROVIDER and EMBED_PROVIDER below; 'ollama' is the older name for the same thing)
AI_MODE=mock
MAX_UPLOAD_MB=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
# Background processing: inline | background | celery (celery needs Redis and a worker, see README)
TASK_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
AUTO_INSIGHTS=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional hosted answer model (retrieval + embeddings stay local). Needs AI_MODE=ollama.
# Put the real key ONLY in your private .env (git-ignored), never here.
CHAT_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0
# Embeddings (turn text into vectors for search). After changing, run:  python -m app.reprocess_all
EMBED_PROVIDER=ollama
# OPENAI_EMBED_MODEL=text-embedding-3-small
# VECTOR_MIN_SIMILARITY=0.5   (tuned for nomic-embed-text; OpenAI usually needs a lower value, measure with: python -m app.evaluate --min-sim 0.3)

# Chunking: own (default) or langchain (sentence-aware RecursiveCharacterTextSplitter). Run reprocess_all after changing.
CHUNKER=own
